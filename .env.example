# Public client configuration (safe to expose)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-anon-key-from-supabase-status
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-anon-key-from-supabase-status

# Server-only configuration — never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local-anon-key-from-supabase-status
SUPABASE_SECRET_KEY=
AI_PROVIDER=deterministic
TRANSLATION_PROVIDER=disabled
AI_MODEL=gpt-5.4-nano
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_DAILY_BUDGET_MINOR=0
PAYMENT_PROVIDER=offline
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
SALLAH_SUPPORT_EMAIL=support@example.invalid
SALLAH_PUBLIC_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=
SAFETY_EMERGENCY_GUIDANCE_AR=
SALLAH_IOS_BUNDLE_ID=sa.example.sallah
SALLAH_ANDROID_PACKAGE=sa.example.sallah
EAS_PROJECT_ID=
MAP_PROVIDER=native
SALLAH_ANDROID_GOOGLE_MAPS_API_KEY=

# Production identity and policy URLs (human-owned; placeholders are rejected)
SALLAH_LEGAL_ENTITY=REQUIRES_HUMAN_INPUT
SALLAH_PRIVACY_URL=https://example.invalid/privacy
SALLAH_TERMS_URL=https://example.invalid/terms
