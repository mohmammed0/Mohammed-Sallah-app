{
  "name": "sallah-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:local-supabase": "node scripts/test-local-supabase.mjs",
    "test:media-scanner": "node scripts/test-media-scanner.mjs",
    "test:media-scanner:remux": "node scripts/test-media-scanner-remux.mjs",
    "test:media-scanner:fixtures": "node --test scripts/test-media-scanner-fixtures.test.mjs",
    "test:media-scanner:supabase": "node scripts/test-media-scanner-supabase.mjs",
    "test:media-scanner:cleanup": "node scripts/test-media-scanner-supabase.mjs --self-check",
    "test:media-scanner:unit": "node --test scripts/test-media-scanner.test.mjs",
    "test:media-scanner:gates": "node --test scripts/test-media-scanner-ci.test.mjs",
    "test:edge-memory": "node --test scripts/test-edge-memory.test.mjs",
    "test:legacy-upgrade": "node scripts/test-legacy-timing-upgrade.mjs",
    "test:db": "node scripts/run-command.mjs supabase test db",
    "test:security": "vitest run tests/security",
    "test:e2e:web": "node scripts/test-web-e2e.mjs",
    "test:e2e:mobile": "node scripts/mobile-e2e.mjs",
    "test:load:smoke": "node scripts/run-k6.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check:test": "node --test scripts/check-docs.test.mjs",
    "docs:check": "pnpm docs:check:test && node scripts/check-docs.mjs",
    "validate": "pnpm format:check && pnpm docs:check && pnpm i18n:check && pnpm customer-captures:check && pnpm data-inventory:check && pnpm test:media-scanner:gates && pnpm lint && pnpm typecheck && pnpm test && pnpm build:validate",
    "build:validate": "node scripts/run-validation-build.mjs",
    "mobile:expo-check": "pnpm --filter @sallah/mobile exec expo export --platform android --output-dir .expo-check",
    "mobile:expo-doctor": "pnpm --filter @sallah/mobile exec expo-doctor",
    "config:validate:production": "node --experimental-strip-types scripts/validate-production-config.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "customer-captures:check": "node scripts/render-customer-captures.mjs --check",
    "data-inventory:check": "node scripts/check-data-inventory.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:container": "node scripts/generate-container-sbom.mjs",
    "prepare": "node scripts/prepare.mjs",
    "test:functions": "node scripts/test-edge-functions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
