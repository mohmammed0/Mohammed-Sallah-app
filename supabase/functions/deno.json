{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "lock": "./deno.lock",
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0
}
